# Copy this file to .env and fill in your key.
# Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model routing. Run `python list_models.py` to see the exact IDs your key can use.
# FAST  -> every short voice command (Nemotron Nano)
# SMART -> long brain-dumps and multi-step edits (Nemotron Super)
# DEEP  -> breaking big goals into plans (Nemotron Ultra)
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SMART=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
